        "team-logos": { "access": "public-read", "signed_upload": true, "note": "شعارات الفرق" },
        "competition-images": { "access": "public-read", "signed_upload": true, "note": "صور البطولات" },
        "challenge-images": { "access": "public-read", "signed_upload": true, "note": "صور التحديات (بمبا/أنت المدرب/Quiz)" },
        "prize-images": { "access": "public-read", "signed_upload": true, "note": "صور الجوائز" },
        "partner-images": { "access": "public-read", "signed_upload": true, "note": "صور الشركاء" },
        "user-uploads": { "access": "public-read", "signed_upload": true, "note": "رفع المستخدمين (avatar وغيره) — توقيع قصير الأمد فقط", "policy": "validate MIME & size at the edge (Worker/WAF) and enforce ownership key per user" },
        "support-attachments": { "access": "private", "signed_read": "15m", "signed_upload": true, "note": "مرفقات الدعم — قراءة موقّعة فقط" }
      }
    }
